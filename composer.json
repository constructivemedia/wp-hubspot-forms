{
  "name": "constructivemedia/wp-hubspot-forms",
  "description": "Embed HubSpot forms with [hubspot] and fill their fields by property name from PHP and JavaScript.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs -p",
    "phpcbf": "phpcbf -p",
    "build": [
      "@test",
      "@phpcs",
      "bash bin/build"
    ]
  }
}
